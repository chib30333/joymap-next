# ---- Database (PostgreSQL) ----
# Local: docker run --name joymap-pg -e POSTGRES_PASSWORD=postgres -e POSTGRES_DB=joymap -p 5432:5432 -d postgres:16
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/joymap?schema=public"

# ---- Auth ----
# 32+ char secret used to sign the session JWT cookie. Generate: openssl rand -base64 32
SESSION_SECRET="change-me-to-a-long-random-string-at-least-32-chars"

# ---- App ----
# Simulated network latency (ms) added to mutations, mirroring the prototype. Set 0 to disable.
API_LATENCY_MS="450"
